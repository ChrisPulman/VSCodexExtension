<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>VSCodex</RootNamespace>
    <AssemblyName>VSCodex</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyTitle>VSCodex</AssemblyTitle>
    <Description>Reactive VSCodex tool window for Visual Studio</Description>
    <Company>Chris Pulman</Company>
    <Product>VSCodex</Product>
    <Copyright>Copyright © Chris Pulman</Copyright>
    <Version Condition="'$(Version)' == ''">0.4.0-preview.0</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.0.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.4.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <VSCodexVersion Condition="'$(VSCodexVersion)' == ''">0.4.0.0</VSCodexVersion>
    <!-- VSIX settings from the current Visual Studio SDK-style project template. -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <DeployExtension>false</DeployExtension>
    <VSSDKTargetPlatformRegRootSuffix Condition="'$(VSSDKTargetPlatformRegRootSuffix)' == ''">Exp</VSSDKTargetPlatformRegRootSuffix>
    <DebuggerFlavor Condition="'$(Configuration)' == 'Debug'">VsixDebugger</DebuggerFlavor>
    <VSCodexUseVsixInstallerDeployment Condition="'$(VSCodexUseVsixInstallerDeployment)' == ''">true</VSCodexUseVsixInstallerDeployment>
    <VSCodexVsixInstallerPath Condition="'$(VSCodexVsixInstallerPath)' == '' and '$(DevEnvDir)' != ''">$(DevEnvDir)VSIXInstaller.exe</VSCodexVsixInstallerPath>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <ApplicationIcon>Resources\VSCodexIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VSCodex.Core\VSCodex.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Design" />
    <Reference Include="System.Speech" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="ReactiveUI.WPF" />
    <PackageReference Include="ReactiveUI.Extensions" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageDownload Include="CP.ReactiveMemory.Mcp.Server" Version="[$(CPReactiveMemoryMcpServerVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <VSCTCompile Include="Commands\CodexCommands.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <None Update="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="Resources\codex-bridge.mjs">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\VSCodexIcon.ico" />
    <Resource Include="Resources\VSCodexIcon-32.png" />
    <Content Include="Resources\VSCodexIcon-128.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\VSCodexIcon-256.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\VSCodexIcon.svg">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="IncludeVSCodexRuntimeAssembliesInVsix" AfterTargets="GetVsixSourceItems">
    <ItemGroup>
      <_VSCodexRuntimeAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'Microsoft.Bcl.AsyncInterfaces.dll'" />
      <_VSCodexRuntimeAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'Microsoft.Bcl.TimeProvider.dll'" />
      <_VSCodexRuntimeAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'Newtonsoft.Json.dll'" />
      <_VSCodexRuntimeAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'System.Buffers.dll'" />
      <_VSCodexRuntimeAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'System.Collections.Immutable.dll'" />
      <_VSCodexRuntimeAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'System.IO.Pipelines.dll'" />
      <_VSCodexRuntimeAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'System.Memory.dll'" />
      <_VSCodexRuntimeAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'System.Numerics.Vectors.dll'" />
      <_VSCodexRuntimeAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'System.Runtime.CompilerServices.Unsafe.dll'" />
      <_VSCodexRuntimeAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'System.Text.Json.dll'" />
      <_VSCodexRuntimeAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'System.Threading.Tasks.Extensions.dll'" />
      <VSIXSourceItem Include="@(_VSCodexRuntimeAssembly)">
        <VSIXSubPath>$(AssemblyVSIXSubPath)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>
  <Target Name="SetVSCodexVsixVersion" BeforeTargets="DetokenizeVsixManifestFile">
    <ItemGroup>
      <VsixReplacement Remove="VSCodexVersion" />
      <VsixReplacement Include="VSCodexVersion" Value="$(VSCodexVersion)" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeReactiveMemoryServerInVsix" BeforeTargets="GetVsixSourceItems">
    <PropertyGroup>
      <_VSCodexReactiveMemoryPackageRoot>$(NuGetPackageRoot)cp.reactivememory.mcp.server\$(CPReactiveMemoryMcpServerVersion)\tools\net10.0\any\</_VSCodexReactiveMemoryPackageRoot>
    </PropertyGroup>
    <ItemGroup>
      <_VSCodexReactiveMemoryServerFile Include="$(_VSCodexReactiveMemoryPackageRoot)**\*" />
      <VSIXSourceItem Include="@(_VSCodexReactiveMemoryServerFile)">
        <VSIXSubPath>ReactiveMemory\%(RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
    <Error Condition="'$(DesignTimeBuild)' != 'true' and '@(_VSCodexReactiveMemoryServerFile)' == ''" Text="The required CP.ReactiveMemory.Mcp.Server $(CPReactiveMemoryMcpServerVersion) payload was not restored." />
  </Target>
  <Target Name="IncludeVSCodexCommandTableInVsix" BeforeTargets="GetVsixSourceItems" DependsOnTargets="VSCTCompile">
    <ItemGroup>
      <VSIXSourceItem Include="$(IntermediateOutputPath)CodexCommands.cto" Condition="Exists('$(IntermediateOutputPath)CodexCommands.cto')">
        <TargetPath>Menus.ctmenu</TargetPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>
  <Target Name="InstallVSCodexVsixWithInstaller" AfterTargets="CreateVsixContainer" Condition="'$(CreateVsixContainer)' == 'true' and '$(TargetVsixContainer)' != '' and '$(VSCodexUseVsixInstallerDeployment)' == 'true' and ('$(DeployVSCodexVsixWithInstaller)' == 'true' or ('$(Configuration)' == 'Debug' and '$(BuildingInsideVisualStudio)' == 'true'))">
    <PropertyGroup>
      <_VSCodexVsixInstallLog>$(IntermediateOutputPath)VSCodex.vsixinstall.log</_VSCodexVsixInstallLog>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\install-vsix-experimental.ps1&quot; -VsixPath &quot;$(TargetVsixContainer)&quot; -VsixInstallerPath &quot;$(VSCodexVsixInstallerPath)&quot; -RootSuffix &quot;$(VSSDKTargetPlatformRegRootSuffix)&quot; -InstanceId &quot;$(DeployTargetInstanceId)&quot; -LogFile &quot;$(_VSCodexVsixInstallLog)&quot;" />
  </Target>
  <Target Name="CreateVSCodexVsixInstallerLauncher" AfterTargets="CreateVsixContainer" Condition="'$(CreateVsixContainer)' == 'true' and '$(TargetVsixContainer)' != ''">
    <PropertyGroup>
      <_VSCodexVsixLauncherScript>$(OutputPath)Install-VSCodex.ps1</_VSCodexVsixLauncherScript>
      <_VSCodexVsixLauncherCommand>$(OutputPath)Install-VSCodex.cmd</_VSCodexVsixLauncherCommand>
    </PropertyGroup>
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\scripts\launch-vsix-installer.ps1" DestinationFiles="$(_VSCodexVsixLauncherScript)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_VSCodexVsixLauncherCommandLine Include="@echo off" />
      <_VSCodexVsixLauncherCommandLine Include="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;%~dp0Install-VSCodex.ps1&quot; -VsixPath &quot;%~dp0VSCodex.vsix&quot;" />
    </ItemGroup>
    <WriteLinesToFile File="$(_VSCodexVsixLauncherCommand)" Lines="@(_VSCodexVsixLauncherCommandLine)" Overwrite="true" Encoding="ASCII" />
    <ItemGroup>
      <FileWrites Include="$(_VSCodexVsixLauncherScript)" />
      <FileWrites Include="$(_VSCodexVsixLauncherCommand)" />
    </ItemGroup>
  </Target>
  <Target Name="LaunchVSCodexVsixInstaller" AfterTargets="CreateVSCodexVsixInstallerLauncher" Condition="'$(CreateVsixContainer)' == 'true' and '$(TargetVsixContainer)' != '' and '$(VSCodexLaunchVsixInstaller)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(OutputPath)Install-VSCodex.ps1&quot; -VsixPath &quot;$(TargetVsixContainer)&quot; -VsixInstallerPath &quot;$(VSCodexVsixInstallerPath)&quot;" />
  </Target>
</Project>
