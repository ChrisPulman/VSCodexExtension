<UserControl
    x:Class="VSCodex.Views.VSCodexToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VSCodex.Controls"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:views="clr-namespace:VSCodex.Views"
    xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    x:Name="Root"
    MinWidth="240"
    MinHeight="360"
    Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
    Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}">
    <UserControl.Resources>
        <views:RoleBrushConverter x:Key="RoleBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="{x:Type controls:MarkdownTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>

        <Style x:Key="MessageTextBoxStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style x:Key="VSCodexComboBoxEditableTextBoxStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton
                                x:Name="DropDownToggle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                ClickMode="Press"
                                Focusable="False"
                                Foreground="{TemplateBinding Foreground}"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border
                                            x:Name="ToggleBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Path
                                                    x:Name="Arrow"
                                                    Width="8"
                                                    Height="5"
                                                    Margin="0,0,8,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Data="M 0 0 L 4 4 L 8 0 Z"
                                                    Fill="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBackgroundBrushKey}}" />
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBorderBrushKey}}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBackgroundBrushKey}}" />
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBorderBrushKey}}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledBackgroundBrushKey}}" />
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledBorderBrushKey}}" />
                                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledTextBrushKey}}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter
                                x:Name="ContentSite"
                                Margin="8,3,26,3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                IsHitTestVisible="False" />
                            <TextBox
                                x:Name="PART_EditableTextBox"
                                Margin="4,3,26,3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                IsReadOnly="{TemplateBinding IsReadOnly}"
                                Style="{StaticResource VSCodexComboBoxEditableTextBoxStyle}"
                                Visibility="Hidden" />
                            <Popup
                                x:Name="Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border
                                        Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxPopupBackgroundBeginBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                        BorderThickness="1" />
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBackgroundBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedTextBrushKey}}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledBackgroundBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledTextBrushKey}}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledBorderBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBackgroundBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBorderBrushKey}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledBackgroundBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledBorderBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxPopupBackgroundBeginBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxItemTextBrushKey}}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxItemMouseOverBackgroundBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxItemMouseOverTextBrushKey}}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxSelectionBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style
            x:Key="CompactButtonStyle"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,5,5" />
        </Style>

        <Style
            x:Key="IconButtonStyle"
            BasedOn="{StaticResource CompactButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="VoiceInputButtonStyle"
            BasedOn="{StaticResource IconButtonStyle}"
            TargetType="Button">
            <Setter Property="ToolTip" Value="{Binding VoiceInputStatus}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsListeningToVoice}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBackgroundBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBorderBrushKey}}" />
                    <Setter Property="ToolTip" Value="Listening. Click to stop VSCodex voice input." />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="PrimaryRunButtonStyle"
            BasedOn="{StaticResource IconButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="ToolTip" Value="Send" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunControlInStopMode}" Value="True">
                    <Setter Property="ToolTip" Value="Stop" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>

        <Style x:Key="PromptResizeThumbStyle" TargetType="{x:Type primitives:Thumb}">
            <Setter Property="Height" Value="7" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Border
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            ToolTip="{TemplateBinding ToolTip}">
                            <Border
                                Width="42"
                                Height="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabBorderBrushKey}}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border
                            x:Name="TabBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                            <ContentPresenter
                                x:Name="HeaderSite"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabHotTextBrushKey}}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabHotBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBackgroundBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedTextBrushKey}}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabInactiveTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBackgroundBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBorderBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style TargetType="controls:ProgressRing">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedTextBrushKey}}" />
            <Setter Property="CoverRingStroke" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>

        <Style TargetType="StatusBarItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>

        <Style x:Key="SectionHeaderTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>

        <Style x:Key="FieldLabelTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <DataTemplate x:Key="RateLimitTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="{Binding Label}" />
                <TextBlock
                    Grid.Column="1"
                    Opacity="0.86"
                    Text="{Binding Remaining}"
                    TextTrimming="CharacterEllipsis" />
                <controls:ProgressRing
                    Grid.Column="2"
                    Width="15"
                    Height="15"
                    Margin="5,0"
                    Progress="{Binding UsagePercent}" />
                <TextBlock
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    Opacity="0.72"
                    Text="{Binding ResetText}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="10,7"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <Image
                        Width="20"
                        Height="20"
                        Margin="0,0,7,6"
                        VerticalAlignment="Center"
                        Source="/VSCodex;component/Resources/VSCodexIcon-32.png"
                        ToolTip="VSCodex" />
                    <Button
                        AutomationProperties.Name="New VSCodex thread"
                        Command="{Binding NewThreadCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Start a fresh VSCodex thread.">
                        <Viewbox
                            Width="14"
                            Height="14"
                            Stretch="Uniform">
                            <Grid Width="16" Height="16">
                                <Path
                                    Data="M3,2 L10,2 L13,5 L13,14 L3,14 Z M10,2 L10,5 L13,5"
                                    Fill="Transparent"
                                    Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                    StrokeEndLineCap="Square"
                                    StrokeLineJoin="Miter"
                                    StrokeThickness="1.4" />
                                <Path
                                    Data="M5,9 L11,9 M8,6 L8,12"
                                    Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                    StrokeEndLineCap="Square"
                                    StrokeThickness="1.4" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button
                        AutomationProperties.Name="Open VSCodex history"
                        Command="{Binding ShowHistoryCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Open VSCodex conversation history.">
                        <Viewbox
                            Width="15"
                            Height="15"
                            Stretch="Uniform">
                            <Grid Width="16" Height="16">
                                <Path
                                    Data="M8,2 A6,6 0 1 1 3.8,3.8 M3.8,3.8 L3.8,6.8 M3.8,3.8 L6.8,3.8"
                                    Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                    StrokeEndLineCap="Square"
                                    StrokeLineJoin="Miter"
                                    StrokeThickness="1.4" />
                                <Path
                                    Data="M8,5 L8,8.2 L11,9.8"
                                    Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                    StrokeEndLineCap="Square"
                                    StrokeLineJoin="Miter"
                                    StrokeThickness="1.4" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button
                        AutomationProperties.Name="Open VSCodex controls"
                        Click="OnOpenToolPanelClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Open VSCodex controls for setup, history, context, skills, MCP, analytics, memory, agents, and attachments.">
                        <Viewbox
                            Width="15"
                            Height="15"
                            Stretch="Uniform">
                            <Grid Width="16" Height="16">
                                <Path
                                    Data="M8,5.2 A2.8,2.8 0 1 1 8,10.8 A2.8,2.8 0 0 1 8,5.2 Z M8,1.5 L9.1,1.5 L9.6,3.2 A5.1,5.1 0 0 1 10.9,3.8 L12.5,3 L13.3,3.8 L12.5,5.4 A5.1,5.1 0 0 1 13.1,6.7 L14.8,7.2 L14.8,8.8 L13.1,9.3 A5.1,5.1 0 0 1 12.5,10.6 L13.3,12.2 L12.2,13.3 L10.6,12.5 A5.1,5.1 0 0 1 9.3,13.1 L8.8,14.8 L7.2,14.8 L6.7,13.1 A5.1,5.1 0 0 1 5.4,12.5 L3.8,13.3 L2.7,12.2 L3.5,10.6 A5.1,5.1 0 0 1 2.9,9.3 L1.2,8.8 L1.2,7.2 L2.9,6.7 A5.1,5.1 0 0 1 3.5,5.4 L2.7,3.8 L3.8,2.7 L5.4,3.5 A5.1,5.1 0 0 1 6.7,2.9 L7.2,1.5 Z"
                                    Fill="Transparent"
                                    Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                    StrokeEndLineCap="Square"
                                    StrokeLineJoin="Miter"
                                    StrokeThickness="1.2" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Rate limits" />
                        <StackPanel Grid.Column="1">
                            <ItemsControl
                                AutomationProperties.Name="Rate limits remaining"
                                ItemTemplate="{StaticResource RateLimitTemplate}"
                                ItemsSource="{Binding RateLimits}"
                                ToolTip="{Binding RateLimitUpdatedAt}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Context" />
                                <controls:ProgressRing
                                    Grid.Column="1"
                                    Width="15"
                                    Height="15"
                                    Margin="42,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CoverRingStroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                                    Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedTextBrushKey}}"
                                    Progress="{Binding ModelEstimate.ContextRemainingPercent}"
                                    ToolTip="{Binding ContextWindowSummary}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Opacity="0.78"
                                    Text="{Binding ContextRemainingSummary}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </WrapPanel>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,3,0,4"
                    Opacity="0.72"
                    Text="{Binding Status}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,0,0,2"
                    FontSize="11"
                    Opacity="0.62"
                    Text="{Binding CurrentWorkspaceDisplay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <DockPanel>
                <ListBox
                    x:Name="ConversationListBox"
                    BorderThickness="0"
                    ItemsSource="{Binding Messages}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="8,6"
                                Padding="10"
                                BorderThickness="1"
                                CornerRadius="3">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <Ellipse
                                            Width="10"
                                            Height="10"
                                            Margin="0,3,6,0"
                                            DockPanel.Dock="Left"
                                            Fill="{Binding Role, Converter={StaticResource RoleBrushConverter}}" />
                                        <TextBlock
                                            DockPanel.Dock="Left"
                                            FontWeight="SemiBold"
                                            Text="{Binding Role}" />
                                        <Button
                                            Margin="6,0,0,0"
                                            Command="{Binding DataContext.UseMessageAsPromptCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="Use as prompt"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource CompactButtonStyle}"
                                            ToolTip="Copy this message into the prompt input for editing." />
                                        <Button
                                            Margin="6,0,0,0"
                                            Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="Copy"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource CompactButtonStyle}"
                                            ToolTip="Copy this message text to the clipboard." />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            DockPanel.Dock="Right"
                                            Opacity="0.65"
                                            Text="{Binding Timestamp}"
                                            TextAlignment="Right" />
                                    </DockPanel>
                                    <controls:MarkdownTextBlock Markdown="{Binding Content}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <DockPanel
            Grid.Row="1"
            Grid.RowSpan="2"
            Width="620"
            MinWidth="360"
            MaxWidth="{Binding ActualWidth, ElementName=Root}"
            HorizontalAlignment="Right"
            Panel.ZIndex="10"
            Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
            Visibility="{Binding IsToolPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                Padding="8,6"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="VSCodex controls" />
                    <Button
                        Grid.Column="1"
                        Margin="0"
                        AutomationProperties.Name="Close VSCodex controls"
                        Click="OnCloseToolPanelClick"
                        Content="Close"
                        Style="{StaticResource CompactButtonStyle}" />
                </Grid>
            </Border>
            <TabControl
                Margin="0"
                IsHitTestVisible="{Binding CanEditSettings}"
                SelectedIndex="{Binding SelectedToolTabIndex, Mode=TwoWay}">
                <TabItem Header="History">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBox
                                Margin="0,0,0,8"
                                AcceptsReturn="False"
                                Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Search VSCodex conversation history." />
                            <WrapPanel>
                                <Button
                                    Command="{Binding NewThreadCommand}"
                                    Content="New thread"
                                    Style="{StaticResource CompactButtonStyle}" />
                                <Button
                                    Command="{Binding RefreshHistoryCommand}"
                                    Content="Refresh"
                                    Style="{StaticResource CompactButtonStyle}" />
                            </WrapPanel>
                        </StackPanel>
                        <ListBox
                            ItemsSource="{Binding VisibleHistoryItems}"
                            MouseDoubleClick="OnHistoryItemDoubleClick"
                            SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="2,4"
                                        Padding="8"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBox
                                                Margin="0,6,0,4"
                                                AcceptsReturn="False"
                                                Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                Opacity="0.72"
                                                Text="{Binding Preview}"
                                                TextTrimming="CharacterEllipsis" />
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBlock
                                                    DockPanel.Dock="Left"
                                                    FontSize="11"
                                                    Opacity="0.66"
                                                    Text="{Binding UpdatedDisplay}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    DockPanel.Dock="Left"
                                                    FontSize="11"
                                                    Opacity="0.66"
                                                    Text="{Binding MessageCountDisplay}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    DockPanel.Dock="Left"
                                                    FontSize="11"
                                                    Opacity="0.66"
                                                    Text="{Binding WorkspaceDisplay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button
                                                    Command="{Binding DataContext.LoadHistoryCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="Open"
                                                    Style="{StaticResource CompactButtonStyle}" />
                                                <Button
                                                    Command="{Binding DataContext.BeginRenameHistoryCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="Rename"
                                                    Style="{StaticResource CompactButtonStyle}" />
                                                <Button
                                                    Command="{Binding DataContext.SaveRenameHistoryCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="Save"
                                                    Style="{StaticResource CompactButtonStyle}"
                                                    Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Button
                                                    Command="{Binding DataContext.CancelRenameHistoryCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="Discard"
                                                    Style="{StaticResource CompactButtonStyle}"
                                                    Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Button
                                                    Command="{Binding DataContext.DeleteHistoryCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="Delete"
                                                    Style="{StaticResource CompactButtonStyle}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Setup">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock FontWeight="SemiBold" Text="{Binding CodexSetupSummary}" />
                            <TextBlock
                                Margin="0,6,0,10"
                                Opacity="0.72"
                                Text="{Binding CodexSetupInstructions}" />
                            <Button
                                HorizontalAlignment="Left"
                                Command="{Binding CheckPrerequisitesCommand}"
                                Content="Check"
                                Style="{StaticResource CompactButtonStyle}"
                                ToolTip="Check VSCodex prerequisites again." />
                            <ItemsControl ItemsSource="{Binding Prerequisites}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,6,0,0"
                                            Padding="8"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock
                                                        DockPanel.Dock="Left"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        DockPanel.Dock="Right"
                                                        Opacity="0.72"
                                                        Text="{Binding Status}" />
                                                </DockPanel>
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Opacity="0.76"
                                                    Text="{Binding Description}" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Opacity="0.66"
                                                    Text="{Binding Details}" />
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button
                                                        Command="{Binding DataContext.CopyPrerequisiteCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Content="Copy command"
                                                        Style="{StaticResource CompactButtonStyle}"
                                                        ToolTip="{Binding ActionCommand}"
                                                        Visibility="{Binding CanCopyCommand, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Button
                                                        Command="{Binding DataContext.UpdatePrerequisiteCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding ActionButtonText}"
                                                        Style="{StaticResource CompactButtonStyle}"
                                                        ToolTip="{Binding ActionCommand}"
                                                        Visibility="{Binding CanUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Context">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            Header="@ files">
                            <ListBox ItemsSource="{Binding FileSuggestions}" MouseDoubleClick="OnReferenceSuggestionDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding ReferenceKey}" />
                                            <TextBlock Opacity="0.72" Text="{Binding RelativePath}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="# references">
                            <ListBox ItemsSource="{Binding ContextSuggestions}" MouseDoubleClick="OnReferenceSuggestionDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding ReferenceKey}" />
                                            <TextBlock Opacity="0.72" Text="{Binding ReferenceKind}" />
                                            <TextBlock Opacity="0.72" Text="{Binding RelativePath}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Skills">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top">
                            <WrapPanel>
                                <Button
                                    Command="{Binding SaveSkillsCommand}"
                                    Content="Save enabled skills"
                                    Style="{StaticResource CompactButtonStyle}" />
                                <Button
                                    Command="{Binding OpenSkillsFolderCommand}"
                                    Content="Open skills folder"
                                    Style="{StaticResource CompactButtonStyle}" />
                            </WrapPanel>
                            <TextBlock
                                Margin="0,2,0,6"
                                Opacity="0.72"
                                Text="{Binding UserSkillsRoot}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Margin="0,0,0,8"
                                Padding="8"
                                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                                BorderThickness="1"
                                CornerRadius="3">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Create skill" />
                                    <TextBlock Style="{StaticResource FieldLabelTextBlock}" Text="Name" />
                                    <TextBox AcceptsReturn="False" Text="{Binding NewSkillName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldLabelTextBlock}" Text="Description" />
                                    <TextBox MinHeight="58" Text="{Binding NewSkillDescription, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        Command="{Binding CreateSkillCommand}"
                                        Content="Create skill"
                                        Style="{StaticResource CompactButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Margin="0,0,0,8"
                                Padding="8"
                                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                                BorderThickness="1"
                                CornerRadius="3">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Additional skill root" />
                                    <TextBox AcceptsReturn="False" Text="{Binding SkillRootPathInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        Command="{Binding AddSkillRootCommand}"
                                        Content="Add folder"
                                        Style="{StaticResource CompactButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Skills}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6">
                                        <CheckBox
                                            Content="{Binding Name}"
                                            FontWeight="SemiBold"
                                            IsChecked="{Binding IsEnabled}" />
                                        <TextBlock Opacity="0.72" Text="{Binding Description}" />
                                        <TextBlock
                                            FontSize="11"
                                            Opacity="0.58"
                                            Text="{Binding MarkdownPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="MCP">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.15*" />
                            <RowDefinition Height="1.35*" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button
                                Command="{Binding AddMcpStdioServerCommand}"
                                Content="Add stdio"
                                Style="{StaticResource CompactButtonStyle}" />
                            <Button
                                Command="{Binding AddMcpUrlServerCommand}"
                                Content="Add URL"
                                Style="{StaticResource CompactButtonStyle}" />
                            <Button
                                Command="{Binding SaveMcpServersCommand}"
                                Content="Save MCP"
                                Style="{StaticResource CompactButtonStyle}" />
                            <Button
                                Command="{Binding OpenCodexConfigCommand}"
                                Content="Open config"
                                Style="{StaticResource CompactButtonStyle}" />
                        </WrapPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" MinWidth="210" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="1.35*" MinWidth="260" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="Servers">
                                <ListBox ItemsSource="{Binding McpServers}" SelectedItem="{Binding SelectedMcpServer}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <CheckBox
                                                        Content="{Binding Name}"
                                                        FontWeight="SemiBold"
                                                        IsChecked="{Binding IsEnabled}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Opacity="0.72"
                                                        Text="{Binding EndpointSummary}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    Command="{Binding DataContext.SelectMcpServerCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="Tools"
                                                    Style="{StaticResource CompactButtonStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>

                            <GridSplitter
                                Grid.Column="1"
                                Width="6"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

                            <GroupBox Grid.Column="2" Header="Selected server">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="8">
                                        <TextBlock Style="{StaticResource FieldLabelTextBlock}" Text="Name" />
                                        <TextBox AcceptsReturn="False" Text="{Binding SelectedMcpServer.Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource FieldLabelTextBlock}" Text="Transport" />
                                        <ComboBox SelectedValue="{Binding SelectedMcpServer.TransportType, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content">
                                            <ComboBoxItem Content="stdio" />
                                            <ComboBoxItem Content="url" />
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource FieldLabelTextBlock}" Text="Command" />
                                        <TextBox AcceptsReturn="False" Text="{Binding SelectedMcpServer.Command, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource FieldLabelTextBlock}" Text="Arguments (one per line)" />
                                        <TextBox MinHeight="60" Text="{Binding SelectedMcpServer.ArgumentsText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource FieldLabelTextBlock}" Text="URL" />
                                        <TextBox AcceptsReturn="False" Text="{Binding SelectedMcpServer.Url, UpdateSourceTrigger=PropertyChanged}" />
                                        <WrapPanel>
                                            <Button
                                                Command="{Binding SelectMcpServerCommand}"
                                                CommandParameter="{Binding SelectedMcpServer}"
                                                Content="List tools"
                                                Style="{StaticResource CompactButtonStyle}" />
                                            <Button
                                                Command="{Binding RemoveMcpServerCommand}"
                                                CommandParameter="{Binding SelectedMcpServer}"
                                                Content="Remove"
                                                Style="{StaticResource CompactButtonStyle}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" MinWidth="230" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="1.35*" MinWidth="260" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="Tools">
                                <ListBox ItemsSource="{Binding McpToolSuggestions}" SelectedItem="{Binding SelectedMcpTool}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Opacity="0.72"
                                                    Text="{Binding Description}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    Grid.Row="2"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.SelectMcpToolCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="Use tool"
                                                    Style="{StaticResource CompactButtonStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>

                            <GridSplitter
                                Grid.Column="1"
                                Width="6"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

                            <GroupBox Grid.Column="2" Header="Tool input">
                                <DockPanel Margin="8">
                                    <Button
                                        HorizontalAlignment="Left"
                                        Command="{Binding InsertMcpToolCommand}"
                                        Content="Insert MCP tool use"
                                        DockPanel.Dock="Bottom"
                                        Style="{StaticResource CompactButtonStyle}" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        DockPanel.Dock="Top"
                                        Opacity="0.76"
                                        Text="{Binding McpInputPrompt}" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding McpToolInputFields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,4,0,8">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayLabel}" />
                                                        <TextBlock Opacity="0.72" Text="{Binding Description}" />
                                                        <TextBox AcceptsReturn="False" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Analytics">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock FontWeight="SemiBold" Text="{Binding AnalyticsSummary}" />
                            <TextBlock
                                Margin="0,6,0,10"
                                Opacity="0.76"
                                Text="{Binding AnalyticsRecommendation}" />
                            <WrapPanel>
                                <Button
                                    Command="{Binding RefreshAnalyticsCommand}"
                                    Content="Refresh analytics"
                                    Style="{StaticResource CompactButtonStyle}" />
                                <Button
                                    Command="{Binding ApplyRecommendedModelCommand}"
                                    Content="Apply recommendation"
                                    Style="{StaticResource CompactButtonStyle}" />
                            </WrapPanel>

                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,12,4"
                                    FontWeight="SemiBold"
                                    Text="Input tokens" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding ModelEstimate.EstimatedInputTokens}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,12,4"
                                    FontWeight="SemiBold"
                                    Text="Output tokens" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding ModelEstimate.EstimatedOutputTokens}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,0,12,4"
                                    FontWeight="SemiBold"
                                    Text="Primary cost" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding ModelEstimate.PrimaryEstimatedCost, StringFormat={}{0:C4}}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,0,12,4"
                                    FontWeight="SemiBold"
                                    Text="Budget cost" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="{Binding ModelEstimate.BudgetEstimatedCost, StringFormat={}{0:C4}}" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,0,12,4"
                                    FontWeight="SemiBold"
                                    Text="Savings" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="{Binding ModelEstimate.EstimatedSavingsPercent, StringFormat={}{0:F0}%}" />
                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Margin="0,0,12,4"
                                    FontWeight="SemiBold"
                                    Text="Complexity" />
                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Text="{Binding ModelEstimate.Complexity}" />
                                <TextBlock
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Margin="0,0,12,4"
                                    FontWeight="SemiBold"
                                    Text="Recommended" />
                                <TextBlock
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Text="{Binding ModelEstimate.RecommendedModel}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Memory">
                    <DockPanel Margin="8">
                        <WrapPanel DockPanel.Dock="Top">
                            <Button
                                Command="{Binding AddUserMemoryCommand}"
                                Content="Save user memory"
                                Style="{StaticResource CompactButtonStyle}" />
                            <Button
                                Command="{Binding AddWorkspaceMemoryCommand}"
                                Content="Save workspace memory"
                                Style="{StaticResource CompactButtonStyle}" />
                            <Button
                                Command="{Binding ScanProjectMemoryCommand}"
                                Content="Scan project"
                                Style="{StaticResource CompactButtonStyle}"
                                ToolTip="Run a full ReactiveMemory ProjectMiner scan for the current solution after Visual Studio has loaded." />
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding Memories}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Scope}" />
                                        <TextBlock Text="{Binding Text}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Agents">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            Header="Roles">
                            <ListBox ItemsSource="{Binding AgentRoles}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6">
                                            <CheckBox
                                                Content="{Binding Name}"
                                                FontWeight="SemiBold"
                                                IsChecked="{Binding IsEnabled}" />
                                            <TextBlock Text="{Binding Role}" />
                                            <TextBlock Opacity="0.72" Text="{Binding Instructions}" />
                                            <TextBlock Style="{StaticResource FieldLabelTextBlock}" Text="Model" />
                                            <ComboBox
                                                IsEditable="True"
                                                ItemsSource="{Binding DataContext.ModelOptions, ElementName=Root}"
                                                Text="{Binding Model, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                            <ComboBox ItemsSource="{Binding DataContext.AgentModelSelectionModeOptions, ElementName=Root}" SelectedItem="{Binding ModelSelectionMode}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="Plan">
                            <ListBox ItemsSource="{Binding OrchestrationSections}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Text="{Binding AssignedAgent}" />
                                            <TextBlock Opacity="0.72" Text="{Binding Status}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Attachments">
                    <DockPanel Margin="8">
                        <WrapPanel DockPanel.Dock="Top">
                            <Button
                                Command="{Binding AddImageAttachmentCommand}"
                                Content="Attach files"
                                Style="{StaticResource CompactButtonStyle}" />
                            <Button
                                Command="{Binding ClearAttachmentsCommand}"
                                Content="Clear attachments"
                                Style="{StaticResource CompactButtonStyle}" />
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding Attachments}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock Opacity="0.72" Text="{Binding Kind}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>

        <Border
            Grid.Row="2"
            Margin="8"
            Padding="8"
            BorderThickness="1"
            CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock
                        Margin="0,3,0,8"
                        Opacity="0.72"
                        Text="Use # for selected code and references, / for focused commands, @ for files, and MCP tools from the controls pane." />
                    <WrapPanel x:Name="ConversationActionPanel">
                        <Button
                            Command="{Binding ReviewSelectionCommand}"
                            Content="Review selection"
                            Style="{StaticResource CompactButtonStyle}"
                            ToolTip="Prepare a focused code review prompt from the current selection." />
                        <Button
                            Command="{Binding DebugSelectionCommand}"
                            Content="Fix active errors"
                            Style="{StaticResource CompactButtonStyle}"
                            ToolTip="Prepare a VSCodex debugging prompt using the active exception or error context." />
                        <Button
                            Command="{Binding CreateTestForSelectionCommand}"
                            Content="Write tests"
                            Style="{StaticResource CompactButtonStyle}"
                            ToolTip="Prepare a test generation prompt from the current selection." />
                        <Button
                            Command="{Binding CreatePlanCommand}"
                            Content="Plan work"
                            Style="{StaticResource CompactButtonStyle}"
                            ToolTip="Create a multi-agent implementation plan." />
                        <Button
                            Command="{Binding RefreshCommand}"
                            Content="+ Reference"
                            Style="{StaticResource CompactButtonStyle}"
                            ToolTip="Refresh workspace references, then use @ files or # references." />
                        <Button
                            Command="{Binding ExplainSelectionCommand}"
                            Content="Explain"
                            Style="{StaticResource CompactButtonStyle}" />
                        <Button
                            Command="{Binding FixSelectionCommand}"
                            Content="Fix"
                            Style="{StaticResource CompactButtonStyle}" />
                        <Button
                            Command="{Binding ReviewSelectionCommand}"
                            Content="Review"
                            Style="{StaticResource CompactButtonStyle}" />
                        <Button
                            Command="{Binding OptimizeSelectionCommand}"
                            Content="Optimize"
                            Style="{StaticResource CompactButtonStyle}" />
                        <Button
                            Command="{Binding GenerateDocsCommand}"
                            Content="Docs"
                            Style="{StaticResource CompactButtonStyle}" />
                    </WrapPanel>
                </StackPanel>

                <primitives:Thumb
                    Grid.Row="1"
                    Margin="0,0,0,2"
                    DragCompleted="OnPromptResizeDragCompleted"
                    DragDelta="OnPromptResizeDragDelta"
                    DragStarted="OnPromptResizeDragStarted"
                    LostMouseCapture="OnPromptResizeLostMouseCapture"
                    PreviewMouseLeftButtonUp="OnPromptResizeMouseLeftButtonUp"
                    Style="{StaticResource PromptResizeThumbStyle}"
                    ToolTip="Drag to resize the prompt input." />

                <TextBox
                    x:Name="PromptTextBox"
                    Grid.Row="2"
                    Height="{Binding InputAreaHeight}"
                    MinHeight="32"
                    MaxHeight="600"
                    AllowDrop="True"
                    AutomationProperties.Name="VSCodex prompt input"
                    Drop="OnPromptDrop"
                    PreviewDragOver="OnPromptPreviewDragOver"
                    PreviewKeyDown="OnPromptPreviewKeyDown"
                    Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Ask VSCodex. Enter sends, Ctrl+Enter inserts a newline, Esc cancels. Use /MCP, /debug, /test, /plan, @filename, or #selection." />

                <Popup
                    x:Name="PromptSuggestionPopup"
                    Grid.Row="2"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsPromptSuggestionOpen, Mode=TwoWay}"
                    Placement="Top"
                    PlacementTarget="{Binding ElementName=PromptTextBox}"
                    StaysOpen="True">
                    <Border
                        Width="{Binding ActualWidth, ElementName=PromptTextBox}"
                        MaxHeight="260"
                        Padding="1"
                        Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxPopupBackgroundBeginBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                        BorderThickness="1">
                        <ListBox
                            x:Name="PromptSuggestionList"
                            MaxHeight="250"
                            ItemsSource="{Binding PromptSuggestions}"
                            KeyboardNavigation.DirectionalNavigation="Contained"
                            MouseDoubleClick="OnPromptSuggestionDoubleClick"
                            SelectedItem="{Binding SelectedPromptSuggestion, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontWeight="SemiBold"
                                            Opacity="0.78"
                                            Text="{Binding Kind}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Opacity="0.72"
                                                Text="{Binding Detail}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <WrapPanel
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,4,6"
                        VerticalAlignment="Center"
                        Opacity="0.76"
                        Text="Agent" />
                    <ComboBox
                        Width="140"
                        MinWidth="118"
                        AutomationProperties.Name="VSCodex request mode"
                        IsHitTestVisible="{Binding CanEditSettings}"
                        ItemsSource="{Binding ModeOptions}"
                        SelectedItem="{Binding Mode}"
                        ToolTip="VSCodex mode for this request." />
                    <TextBlock
                        Margin="4,0,4,6"
                        VerticalAlignment="Center"
                        Opacity="0.76"
                        Text="Model" />
                    <ComboBox
                        Width="180"
                        MinWidth="118"
                        AutomationProperties.Name="VSCodex model"
                        IsEditable="True"
                        IsHitTestVisible="{Binding CanEditSettings}"
                        ItemsSource="{Binding ModelOptions}"
                        Text="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                        ToolTip="Primary model for this request." />
                    <Button
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Toggle VSCodex voice input"
                        Click="OnToggleVoiceInputClick"
                        Style="{StaticResource VoiceInputButtonStyle}">
                        <Grid Width="16" Height="16">
                            <Path
                                Data="M8,2 A2,2 0 0 1 10,4 L10,8 A2,2 0 0 1 6,8 L6,4 A2,2 0 0 1 8,2 Z M4,7 L4,8 A4,4 0 0 0 12,8 L12,7 M8,12 L8,15 M5.5,15 L10.5,15"
                                Stretch="Uniform"
                                Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                StrokeEndLineCap="Square"
                                StrokeLineJoin="Round"
                                StrokeThickness="1.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListeningToVoice}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedTextBrushKey}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Ellipse
                                x:Name="VoiceListeningDot"
                                Width="5"
                                Height="5"
                                Margin="0,0,-1,-1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Fill="#E81123"
                                Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                                StrokeThickness="1"
                                Visibility="{Binding IsListeningToVoice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <TextBlock
                        Margin="2,0,8,6"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#E81123"
                        Text="Listening"
                        Visibility="{Binding IsListeningToVoice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Send or stop VSCodex request"
                        Click="OnRunControlClick"
                        Style="{StaticResource PrimaryRunButtonStyle}">
                        <Grid Width="18" Height="18">
                            <Path
                                x:Name="SendIcon"
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M7,13 L7,2 M2.5,6.5 L7,2 L11.5,6.5"
                                Stretch="Uniform"
                                Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                StrokeEndLineCap="Square"
                                StrokeLineJoin="Miter"
                                StrokeThickness="1.8">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunControlInStopMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Grid x:Name="StopIcon">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunControlInStopMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <controls:ProgressRing
                                    Width="18"
                                    Height="18"
                                    Margin="0"
                                    IsIndeterminate="True"
                                    Opacity="0.35" />
                                <Rectangle
                                    Width="8"
                                    Height="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button
                        Margin="4,0,0,6"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Stop VSCodex request"
                        Click="OnStopControlClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Stop the active VSCodex request and clear queued prompts."
                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Width="16" Height="16">
                            <controls:ProgressRing
                                Width="16"
                                Height="16"
                                Margin="0"
                                IsIndeterminate="True"
                                Opacity="0.35" />
                            <Rectangle
                                Width="7"
                                Height="7"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                        </Grid>
                    </Button>
                    <TextBlock
                        Margin="6,0,0,6"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.72"
                        Text="{Binding QueueStatusDisplay}"
                        Visibility="{Binding HasQueuedPrompts, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </WrapPanel>
            </Grid>
        </Border>

        <StatusBar Grid.Row="3">
            <StatusBarItem Content="{Binding Status}" />
            <Separator />
            <StatusBarItem Content="Thread:" />
            <StatusBarItem Content="{Binding ThreadId}" />
            <Separator />
            <StatusBarItem Content="{Binding RateLimitUpdatedAt}" />
        </StatusBar>
    </Grid>
</UserControl>
