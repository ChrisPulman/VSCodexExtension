<UserControl
    x:Class="VSCodex.Controls.ProgressRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    Focusable="False"
    SnapsToDevicePixels="True">
    <Grid>
        <Ellipse
            x:Name="CoverRing"
            Fill="Transparent"
            Stroke="{Binding CoverRingStroke, ElementName=Root}"
            Visibility="{Binding CoverRingVisibility, ElementName=Root}" />
        <Path
            x:Name="ProgressArc"
            Fill="Transparent"
            RenderTransformOrigin="0.5,0.5"
            Stroke="{Binding Foreground, ElementName=Root}"
            StrokeEndLineCap="Round"
            StrokeStartLineCap="Round">
            <Path.RenderTransform>
                <RotateTransform x:Name="ProgressArcRotation" />
            </Path.RenderTransform>
        </Path>
    </Grid>
</UserControl>
