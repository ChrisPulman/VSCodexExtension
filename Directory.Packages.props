<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CPReactiveMemoryMcpServerVersion>1.1.2</CPReactiveMemoryMcpServerVersion>
    <StyleSharpAnalyzersVersion>5.1.4</StyleSharpAnalyzersVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="10.0.14" />
    <PackageVersion Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <PackageVersion Include="ReactiveUI.Reactive" Version="26.0.1" />
    <PackageVersion Include="ReactiveUI.Primitives.Wpf.Reactive" Version="9.0.0" />
    <PackageVersion Include="ReactiveUI.Wpf.Reactive" Version="26.0.1" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="StyleSharp.Analyzers" Version="$(StyleSharpAnalyzersVersion)" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <PackageVersion Include="TUnit" Version="1.76.0" />
    <PackageVersion Include="CP.Nuke.BuildTools" Version="3.0.2" />
    <PackageVersion Include="Nuke.Common" Version="10.1.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>
</Project>
